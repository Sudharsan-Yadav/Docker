---
version: "3"
services:
  aws:
    container_name: cont1
    image: nginx
    ports:
      - "9999:80"
    volumes:
      - appvolume:/usr/share/nginx/html/

  azure:
    container_name: cont2
    image: httpd
    ports:
      - "8888:80"
    volumes:
      - dbvolume:/usr/local/apache2/htdocs/

volumes:
  appvolume:
  dbvolume:
...
